{
  "name": "agentsapper",
  "version": "0.0.0",
  "description": "Read-only scanner that flags what an untrusted repository can execute or inject before an AI coding agent opens it.",
  "keywords": [
    "security",
    "ai-agents",
    "coding-agents",
    "git",
    "supply-chain",
    "prompt-injection",
    "mcp",
    "sarif"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inakidev/agentsapper.git"
  },
  "homepage": "https://github.com/inakidev/agentsapper#readme",
  "bugs": {
    "url": "https://github.com/inakidev/agentsapper/issues"
  },
  "type": "module",
  "bin": {
    "agentsapper": "dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "selfscan": "node dist/bin.js ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
